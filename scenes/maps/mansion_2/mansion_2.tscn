[sub_resource type="GDScript" id="GDScript_epj47"]
script/source = "extends ComposableEffect

@export var reflection_probe_light1: ReflectionProbe
@export var reflection_probe_light2: ReflectionProbe


func trigger() -> void:
	if reflection_probe_light1:
		reflection_probe_light1.ambient_color = Color(.30,.30,.30)
	if reflection_probe_light2:
		reflection_probe_light2.ambient_color = Color(.30,.30,.30)
"

